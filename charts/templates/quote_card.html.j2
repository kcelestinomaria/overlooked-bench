<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ title }}</title>
<style>
  /* ---------------------------------------------------------------------
     "Asked vs got" and side-by-side cards. 1600x900, same frame, palette and
     rules as social_card.html.j2: system fonts only, fixed pixels, no
     external requests.

     The card never paraphrases. The ASKED side is the constraint text from
     items.yaml; the GOT side is a quote the harness has matched verbatim
     against the archived raw response; the footer carries the path to that
     response so anyone can open it.
     --------------------------------------------------------------------- */
  :root {
    --surface: #fcfcfb;
    --panel: #f4f3f0;
    --ink: #0b0b0b;
    --ink-secondary: #52514e;
    --ink-muted: #8a8880;
    --accent: #2a78d6;
    --warn: #eb6834;
    --ok: #1baf7a;
    --rule: #e6e5e1;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body { width: 1600px; height: 900px; overflow: hidden; }
  body {
    background: var(--surface);
    color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue",
                 Arial, "Noto Sans", sans-serif;
    display: flex; flex-direction: column;
  }
  .rail { height: 10px; background: var(--accent); flex: 0 0 auto; }
  header {
    flex: 0 0 auto; padding: 30px 56px 16px;
    display: flex; align-items: baseline; justify-content: space-between;
    border-bottom: 1px solid var(--rule);
  }
  .wordmark { font-size: 28px; font-weight: 700; letter-spacing: -0.02em; }
  .wordmark .dim { color: var(--accent); }
  .tagline { font-size: 17px; color: var(--ink-secondary); margin-top: 6px; }
  .run-meta { text-align: right; font-size: 16px; color: var(--ink-secondary); line-height: 1.5; }
  .run-meta .date { font-size: 22px; font-weight: 600; color: var(--ink); display: block; }

  .task {
    padding: 22px 56px 0; font-size: 19px; color: var(--ink-secondary);
  }
  .task strong { color: var(--ink); font-weight: 600; }

  main {
    flex: 1 1 auto; min-height: 0; padding: 18px 56px 18px;
    display: grid; grid-template-columns: 1fr 1fr; gap: 28px;
  }
  .panel {
    background: var(--panel); border-radius: 10px; padding: 30px 34px;
    display: flex; flex-direction: column; min-height: 0; overflow: hidden;
    border-top: 6px solid var(--ink-muted);
  }
  .panel.asked { border-top-color: var(--accent); }
  .panel.got { border-top-color: var(--warn); }
  .panel.kept { border-top-color: var(--ok); }
  .label {
    font-size: 15px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--ink-secondary); margin-bottom: 14px;
  }
  .label .who { color: var(--ink); letter-spacing: 0.02em; text-transform: none; font-size: 22px; }
  .big { font-size: {{ asked_size }}px; line-height: 1.28; font-weight: 600; }
  .quote {
    font-size: {{ quote_size }}px; line-height: 1.34; font-weight: 500;
    font-family: Georgia, "Times New Roman", serif;
  }
  .quote::before { content: "\201C"; color: var(--ink-muted); }
  .quote::after { content: "\201D"; color: var(--ink-muted); }
  .context {
    margin-top: 22px; font-size: 21px; line-height: 1.4; color: var(--ink-secondary);
    border-left: 3px solid var(--rule); padding-left: 14px;
  }
  .ctx-label { font-size: 14px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-muted); }
  .facts {
    margin-top: auto; padding-top: 18px; font-size: 15px; color: var(--ink-secondary);
    line-height: 1.5;
  }
  .chip {
    display: inline-block; font-size: 14px; font-weight: 600; padding: 3px 10px;
    border-radius: 999px; margin: 0 6px 6px 0; border: 1.5px solid var(--rule);
    background: var(--surface); color: var(--ink);
  }
  .chip.bad { border-color: var(--warn); }
  .chip.good { border-color: var(--ok); }

  footer {
    flex: 0 0 auto; padding: 14px 56px 26px; border-top: 1px solid var(--rule);
    display: flex; align-items: flex-end; justify-content: space-between; gap: 40px;
  }
  .method { font-size: 14px; color: var(--ink-secondary); line-height: 1.45; max-width: 980px; }
  .source { font-size: 14px; color: var(--ink-muted); text-align: right; line-height: 1.45; }
  .source strong { color: var(--ink-secondary); font-weight: 600; }
  .path { font-family: Consolas, "SF Mono", Menlo, monospace; font-size: 13px; color: var(--ink-secondary); }
</style>
</head>
<body>
  <div class="rail"></div>
  <header>
    <div>
      <div class="wordmark">overlooked<span class="dim">-</span>bench</div>
      <div class="tagline">{{ tagline }}</div>
    </div>
    <div class="run-meta">
      <span class="date">{{ run_id }}</span>
      {{ item_id }} | {{ category_label }}
    </div>
  </header>

  <div class="task"><strong>Task:</strong> {{ item_title }}</div>

  <main>
    {% if mode == "asked_got" %}
    <section class="panel asked">
      <div class="label">Asked - hard constraint {{ constraint_id }}</div>
      <div class="big">{{ constraint_text }}</div>
      <div class="facts">Stated in the prompt as non-negotiable.</div>
    </section>
    <section class="panel got">
      <div class="label">Got - <span class="who">{{ model_display }}</span></div>
      <div class="quote">{{ quote }}</div>
      {% if context %}<div class="context"><span class="ctx-label">Next line of the response:</span> {{ context }}</div>{% endif %}
      <div class="facts">
        <span class="chip bad">Judge: violated</span>
        <span class="chip bad">Verifier p(broken) {{ p_broken }}</span><br>
        Quote matched verbatim against the archived response.
      </div>
    </section>
    {% else %}
    <section class="panel kept">
      <div class="label">Stayed inside - <span class="who">{{ left_model }}</span></div>
      <div class="quote">{{ left_excerpt }}</div>
      <div class="facts">
        {% for chip in left_chips %}<span class="chip good">{{ chip }}</span>{% endfor %}<br>
        Where it handles the same constraint, verbatim. Item score {{ left_score }}.
      </div>
    </section>
    <section class="panel got">
      <div class="label">Broke {{ constraint_id }} - <span class="who">{{ model_display }}</span></div>
      <div class="quote">{{ quote }}</div>
      <div class="facts">
        <span class="chip bad">{{ constraint_text }}</span><br>
        Judge: violated. Verifier p(broken) {{ p_broken }}. Item score {{ right_score }}.
      </div>
    </section>
    {% endif %}
  </main>

  <footer>
    <div class="method">
      {{ methodology_note }}<br>
      <span class="path">{{ raw_path }}</span>
    </div>
    <div class="source">
      <strong>{{ repo_url }}</strong><br>
      Every response and verdict is public
    </div>
  </footer>
</body>
</html>
