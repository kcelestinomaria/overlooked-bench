<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ title }}</title>
<style>
  /* Closing card for a thread. Same frame as the other cards. Every number in
     `points` is computed from summary.json by render_social.py; this template
     only lays it out. */
  :root {
    --surface: #fcfcfb; --ink: #0b0b0b; --ink-secondary: #52514e;
    --ink-muted: #8a8880; --accent: #2a78d6; --rule: #e6e5e1;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body { width: 1600px; height: 900px; overflow: hidden; }
  body {
    background: var(--surface); color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue",
                 Arial, "Noto Sans", sans-serif;
    display: flex; flex-direction: column;
  }
  .rail { height: 10px; background: var(--accent); }
  header {
    padding: 30px 56px 16px; display: flex; align-items: baseline;
    justify-content: space-between; border-bottom: 1px solid var(--rule);
  }
  .wordmark { font-size: 28px; font-weight: 700; letter-spacing: -0.02em; }
  .wordmark .dim { color: var(--accent); }
  .run-meta { text-align: right; font-size: 16px; color: var(--ink-secondary); }
  .run-meta .date { font-size: 22px; font-weight: 600; color: var(--ink); display: block; }
  main { flex: 1 1 auto; padding: 44px 72px 20px; }
  h1 { font-size: 46px; letter-spacing: -0.02em; margin-bottom: 34px; line-height: 1.15; }
  ol { list-style: none; counter-reset: p; }
  li {
    counter-increment: p; font-size: 27px; line-height: 1.38; margin-bottom: 24px;
    padding-left: 62px; position: relative; color: var(--ink);
  }
  li::before {
    content: counter(p); position: absolute; left: 0; top: 0;
    width: 40px; height: 40px; border-radius: 50%; background: var(--accent);
    color: #ffffff; font-size: 21px; font-weight: 700; text-align: center; line-height: 40px;
  }
  li .sub { display: block; font-size: 19px; color: var(--ink-secondary); margin-top: 4px; }
  footer {
    padding: 14px 56px 26px; border-top: 1px solid var(--rule);
    display: flex; justify-content: space-between; gap: 40px; align-items: flex-end;
  }
  .method { font-size: 14px; color: var(--ink-secondary); line-height: 1.45; max-width: 1050px; }
  .source { font-size: 14px; color: var(--ink-muted); text-align: right; line-height: 1.45; }
  .source strong { color: var(--ink-secondary); }
</style>
</head>
<body>
  <div class="rail"></div>
  <header>
    <div class="wordmark">overlooked<span class="dim">-</span>bench</div>
    <div class="run-meta"><span class="date">{{ run_id }}</span>{{ n_models }} models | methodology {{ methodology_version }}</div>
  </header>
  <main>
    <h1>{{ heading }}</h1>
    <ol>
      {% for p in points %}<li>{{ p.text }}<span class="sub">{{ p.sub }}</span></li>{% endfor %}
    </ol>
  </main>
  <footer>
    <div class="method">{{ methodology_note }}</div>
    <div class="source"><strong>{{ repo_url }}</strong><br>Raw outputs and scores published for every run</div>
  </footer>
</body>
</html>
