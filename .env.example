# ---------------------------------------------------------------------------
# overlooked-bench - local configuration
#
# Copy to `.env` and fill in. `.env` is gitignored and must NEVER be committed.
#   cp .env.example .env
#
# Every model in the benchmark is reached through ONE endpoint: the Vercel AI
# Gateway. That means one key for all providers, and no per-provider secrets.
# ---------------------------------------------------------------------------

# Required. Your Vercel AI Gateway key (starts with `vck_`).
AI_GATEWAY_API_KEY=vck_your_key_here

# Optional. Override the gateway base URL (OpenAI-compatible).
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

# Optional. Override the judge model for a run. Defaults to the model marked
# `judge: true` in data/models.yaml. Changing this is a METHODOLOGY CHANGE - 
# see docs/METHODOLOGY.md.
# OB_JUDGE_MODEL=anthropic/claude-opus-4.5

# Optional. Max concurrent in-flight API requests (default 8).
# OB_CONCURRENCY=8

# Optional. Disable DeepEval's anonymous telemetry during runs.
DEEPEVAL_TELEMETRY_OPT_OUT=YES
